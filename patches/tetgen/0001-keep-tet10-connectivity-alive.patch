diff --git a/tetgen.cxx b/tetgen.cxx
index 899a47b..a47ca80 100644
--- a/tetgen.cxx
+++ b/tetgen.cxx
@@ -33331,7 +33331,10 @@ void tetgenmesh::highorder()
   }
 
   // Initialize the 'highordertable'.
-  point *highordertable = new point[tetrahedrons->items * 6];
+  if (highordertable != (point *) NULL) {
+    delete [] highordertable;
+  }
+  highordertable = new point[tetrahedrons->items * 6];
   if (highordertable == (point *) NULL) {
     terminatetetgen(this, 1);
   }
@@ -33402,7 +33405,9 @@ void tetgenmesh::highorder()
     tetloop.tet = tetrahedrontraverse();
   }
 
-  delete [] highordertable;
+  // Keep the table alive until all quadratic output routines have consumed
+  // the pointers stored in tetrahedron slot 11.  It is released by
+  // tetgenmesh::freememory().
 }
 
